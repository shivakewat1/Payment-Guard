# PaymentGuard Configuration

# Environment
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database
# Use SQLite for quick local dev / testing, or PostgreSQL in staging/production:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paymentguard
DATABASE_URL=sqlite:///./payment_guard.db

# Anthropic Claude API (Optional for direct LLM calls; intelligent fallback provided)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Razorpay API Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourSecretKeyHere

# Bounded Recovery Rules
MAX_RETRIES=3
MAX_AMOUNT_AUTO_RETRY=50000
CIRCUIT_BREAKER_THRESHOLD=3
RATE_LIMIT_PER_MINUTE=60
